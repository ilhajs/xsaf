{
  "name": "@xsaf/cli",
  "version": "0.1.0-alpha.0",
  "description": "Standalone interactive terminal CLI for XSAF agents",
  "homepage": "https://xsaf.ilha.build",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ilhajs/xsaf.git",
    "directory": "packages/cli"
  },
  "bin": {
    "xsaf": "./dist/cli.mjs"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./http": {
      "types": "./dist/http.d.mts",
      "import": "./dist/http.mjs"
    }
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "bun test test"
  },
  "dependencies": {
    "@earendil-works/pi-tui": "^0.83.0",
    "clerc": "^1.3.1"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
