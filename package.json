{
  "name": "xsaf-monorepo",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*",
    "templates/*"
  ],
  "type": "module",
  "scripts": {
    "typecheck": "bun run --filter './packages/*' typecheck",
    "test": "bun run --filter './packages/*' test",
    "build": "bun run --filter './packages/*' build",
    "lint": "oxlint",
    "fmt": "oxfmt --write .",
    "fmt:check": "oxfmt --check .",
    "check": "bun run typecheck && bun run lint && bun run fmt:check && bun test && bun run build"
  },
  "devDependencies": {
    "@tsconfig/strictest": "^2.0.8",
    "@types/bun": "latest",
    "oxfmt": "^0.61.0",
    "oxlint": "^1.76.0",
    "pkg-pr-new": "^0.0.86",
    "tsdown": "^0.22.14",
    "typescript": "^7"
  }
}
